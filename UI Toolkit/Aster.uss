:root {
}

Button {
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(226, 226, 226);
    border-right-color: rgb(226, 226, 226);
    border-top-color: rgb(226, 226, 226);
    border-bottom-color: rgb(226, 226, 226);
    background-color: rgba(154, 143, 164, 0.604);
    width: 80%;
    -unity-font-definition: url("project://database/Assets/UI/Audex-Regular.ttf?fileID=12800000&guid=61affa69497acf24482f83549cd870d8&type=3#Audex-Regular");
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    color: rgb(226, 226, 226);
    -unity-text-outline-width: 1px;
    text-shadow: 0.2px 0 1px rgb(0, 0, 0);
}



Button:hover {
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(91, 91, 91);
    border-right-color: rgb(91, 91, 91);
    border-top-color: rgb(91, 91, 91);
    border-bottom-color: rgb(91, 91, 91);
    background-color: rgba(146, 141, 185, 0.718);
    width: 80%;
    -unity-font-definition: url("project://database/Assets/UI/Audex-Regular.ttf?fileID=12800000&guid=61affa69497acf24482f83549cd870d8&type=3#Audex-Regular");
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    color: rgb(91, 91, 91);
    -unity-text-outline-width: 1px;
    text-shadow: 0.2px 0 1px rgba(0, 0, 0, 0);
}

Button:active {
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(91, 91, 91);
    border-right-color: rgb(91, 91, 91);
    border-top-color: rgb(91, 91, 91);
    border-bottom-color: rgb(91, 91, 91);
    background-color: rgb(146, 141, 185);
    width: 80%;
    -unity-font-definition: url("project://database/Assets/UI/Audex-Regular.ttf?fileID=12800000&guid=61affa69497acf24482f83549cd870d8&type=3#Audex-Regular");
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    color: rgb(91, 91, 91);
    -unity-text-outline-width: 1px;
    text-shadow: 1.5px 0 0.5px rgba(255, 255, 255, 0.973);
}
